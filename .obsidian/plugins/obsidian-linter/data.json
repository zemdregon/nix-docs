{
  "ruleConfigs": {
    "yaml-title": {
      "enabled": false
    },
    "yaml-title-alias": {
      "enabled": false
    },
    "yaml-timestamp": {
      "enabled": false
    },
    "file-name-heading": {
      "enabled": false
    },
    "trailing-spaces": {
      "enabled": true,
      "two-space-line-break": false
    },
    "heading-blank-lines": {
      "enabled": true,
      "bottom": true,
      "empty-line-after-yaml": true
    },
    "consecutive-blank-lines": {
      "enabled": true
    },
    "convert-bullet-list-markers": {
      "enabled": false
    },
    "emphasis-style": {
      "enabled": false
    },
    "strong-style": {
      "enabled": false
    },
    "unordered-link": {
      "enabled": false
    },
    "no-bare-urls": {
      "enabled": false
    },
    "auto-correct-common-misspellings": {
      "enabled": false
    }
  },
  "lintOnSave": false,
  "displayChanged": true,
  "settingsMigratedToNewDefaults": true,
  "foldersToIgnore": [
    ".obsidian",
    ".cursor",
    "meta/attachments"
  ],
  "linterLocale": "system-default",
  "commonStyles": {
    "aliasArrayStyle": "single-line",
    "tagArrayStyle": "single-line",
    "minimumNumberOfDollarSignsToAddSpaceAroundMathBlocks": 2,
    "escapeCharacter": "\""
  }
}
